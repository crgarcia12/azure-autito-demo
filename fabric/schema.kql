.create-merge table Telemetry (EventId:string, VehicleId:string, IntervalStart:datetime, Timestamp:datetime, Latitude:real, Longitude:real, SpeedKmh:real, Heading:real, OdometerKm:real, DistanceKm:real, BatteryPct:real, FuelPct:real, TyrePressureBar:real, EngineTempC:real, Status:string, Alert:string, BranchId:string, RouteId:string, RentalId:string, Source:string)

.create-merge table Vehicles (VehicleId:string, Registration:string, Make:string, Model:string, Powertrain:string, Category:string, DailyRateGBP:real, BranchId:string, City:string, BranchName:string, BaseOdometerKm:real, ServiceDueKm:real, Index:int)

.create-merge table Branches (BranchId:string, BranchName:string, City:string, Latitude:real, Longitude:real)

.alter table Telemetry policy streamingingestion enable

.alter table Vehicles policy streamingingestion enable

.alter table Branches policy streamingingestion enable

.alter-merge table Telemetry policy retention softdelete = 30d recoverability = disabled

.create-or-alter function with (folder="Caldova", docstring="Canonical deduplicated telemetry. Each event covers [IntervalStart, Timestamp). Retries retain the same EventId.") FleetEvents() { Telemetry | summarize arg_max(Timestamp, *) by EventId }

.create-or-alter function with (folder="Caldova", docstring="Current digital twin state, joined to the vehicle register.") FleetLatest() { Telemetry | summarize arg_max(Timestamp, *) by VehicleId | lookup kind=leftouter (Vehicles | summarize take_any(*) by VehicleId) on VehicleId }

.create-or-alter function with (folder="Caldova", docstring="Exact interval-based distance allocation for [fromUtc, toUtc), with retry deduplication and boundary interpolation. Distances are kilometers.") FleetDistance(fromUtc:datetime, toUtc:datetime) { FleetEvents() | where Timestamp > fromUtc and IntervalStart < toUtc | extend OverlapSeconds = datetime_diff('millisecond', min_of(Timestamp, toUtc), max_of(IntervalStart, fromUtc)) / 1000.0, IntervalSeconds = datetime_diff('millisecond', Timestamp, IntervalStart) / 1000.0 | where IntervalSeconds > 0 and OverlapSeconds > 0 | extend AllocatedKm = DistanceKm * OverlapSeconds / IntervalSeconds | summarize DistanceKm=sum(AllocatedKm), DrivingMinutes=sumif(OverlapSeconds / 60.0, DistanceKm > 0), LastEvent=max(Timestamp), Samples=count() by VehicleId, BranchId | lookup kind=leftouter (Vehicles | summarize take_any(Registration, Make, Model, City, Powertrain) by VehicleId) on VehicleId }

.create-or-alter function with (folder="Caldova", docstring="Mileage by Europe/Madrid calendar day, including 23/25-hour DST days. Midnight-crossing intervals are split proportionately. The open current day is marked IsComplete=false.") FleetDailyMileage() { FleetEvents() | extend FirstDay=startofday(datetime_utc_to_local(IntervalStart, 'Europe/Madrid')), LastDay=startofday(datetime_utc_to_local(Timestamp - 1tick, 'Europe/Madrid')) | mv-expand LocalDay=range(FirstDay, LastDay, 1d) to typeof(datetime) | extend DayStart=datetime_local_to_utc(LocalDay, 'Europe/Madrid'), DayEnd=datetime_local_to_utc(LocalDay + 1d, 'Europe/Madrid') | extend OverlapSeconds=datetime_diff('millisecond', min_of(Timestamp, DayEnd), max_of(IntervalStart, DayStart)) / 1000.0, IntervalSeconds=datetime_diff('millisecond', Timestamp, IntervalStart) / 1000.0 | where IntervalSeconds > 0 and OverlapSeconds > 0 | extend AllocatedKm=DistanceKm * OverlapSeconds / IntervalSeconds | summarize DistanceKm=sum(AllocatedKm), DrivingMinutes=sumif(OverlapSeconds / 60.0, DistanceKm > 0), Samples=count(), FirstEvent=min(IntervalStart), LastEvent=max(Timestamp) by VehicleId, BranchId, LocalDay, DayStart, DayEnd | extend ReportDate=format_datetime(LocalDay, 'yyyy-MM-dd'), TimeZone='Europe/Madrid', IsComplete=DayEnd <= now(), AsOf=now() | lookup kind=leftouter (Vehicles | summarize take_any(Registration, Make, Model, City, Powertrain) by VehicleId) on VehicleId | project-away LocalDay }
